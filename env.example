# Public site configuration
NEXT_PUBLIC_APP_URL=https://climate-seal.com
# NEXT_PUBLIC_GSC_VERIFICATION=your_google_search_console_token
# NEXT_PUBLIC_BING_VERIFICATION=your_bing_webmaster_token
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# Anthropic API configuration
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Email delivery configuration
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Climate Seal <noreply@climate-seal.com>
EMAIL_TO=contact@climate-seal.com

# SMTP fallback, optional when Resend is configured
# EMAIL_HOST=your_email_host
# EMAIL_PORT=587
# EMAIL_USER=your_email_user
# EMAIL_PASS=your_email_password
# EMAIL_FROM=Climate Seal <noreply@climate-seal.com>

# Admin configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_SESSION_SECRET=choose_a_long_random_secret

# Stripe server configuration, required for payment API
# STRIPE_SECRET_KEY=sk_live_your_secret_key
